# .env.example — Campus Arena Web (Frontend Next.js)
# Copia este archivo como .env.local para desarrollo local, o configúralo en Vercel/Netlify

# === Backend API Base URL ===
# En desarrollo: http://localhost:3001/api/v1
# En producción: https://api.campusarena.tecsup.edu.pe/api/v1 o tu URL en Render/Railway
NEXT_PUBLIC_API_URL="http://localhost:3001/api/v1"

# === Supabase Realtime & Storage ===
NEXT_PUBLIC_SUPABASE_URL="https://tu-proyecto.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="tu-anon-public-key"
