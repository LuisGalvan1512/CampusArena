# .env.example — Campus Arena API
# Copia este archivo como .env y completa los valores

# === Base de Datos (Supabase PostgreSQL) ===
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# === JWT ===
JWT_SECRET="tu-secreto-jwt-seguro-aqui"
JWT_EXPIRATION=900

# === Frontend URL (CORS) ===
FRONTEND_URL="http://localhost:3000"

# === Servicio de Correo (Brevo/Sendinblue SMTP) ===
# Obtener API key en: https://app.brevo.com/settings/keys/api
BREVO_API_KEY="tu-api-key-de-brevo"
SMTP_HOST="smtp-relay.brevo.com"
SMTP_PORT=587
SMTP_USER="tu-smtp-user@smtp-brevo.com"
SMTP_PASS="tu-smtp-key-de-brevo"
SMTP_FROM="correo-remitente@tecsup.edu.pe"
